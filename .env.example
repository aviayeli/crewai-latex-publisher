ANTHROPIC_API_KEY=your-anthropic-api-key-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here
PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
# Haiku is ~20x cheaper than Sonnet. Upgrade to sonnet only for final production runs.
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
MAX_ITER=15
MAX_TOKENS=4096
MAX_AGENT_RETRIES=3
PYTHON_RUNNER_TIMEOUT_S=60
LUALATEX_BIN=lualatex
BIBER_BIN=biber
PANDOC_BIN=pandoc
OUTPUT_DIR=latex_output
ASSETS_DIR=latex_output/assets
MIN_PAGES=15
