# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# LaTeX build artifacts — globally ignored in all directories
**/*.aux
**/*.bbl
**/*.bcf
**/*.blg
**/*.fdb_latexmk
**/*.fls
**/*.log
**/*.out
**/*.run.xml
**/*.toc
latex_output/chapters/*.tex
latex_output/assets/*.png
latex_output/figures/*.tex
latex_output/main.tex
latex_output/*.pdf

# Coverage
.coverage
htmlcov/

# uv
.uv/
